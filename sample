}

// DeleteExpense menghapus pengeluaran
func (a *App) DeleteExpense(id string) Response {
	if id == "" {
		return Response{
			Success: false,
			Message: "ID pengeluaran harus diisi",
		}
	}

	result, err := a.db.Exec("DELETE FROM expenses WHERE id = ?", id)
	if err != nil {
		return Response{
			Success: false,
			Message: "Gagal menghapus pengeluaran: " + err.Error(),
		}
	}

	rowsAffected, _ := result.RowsAffected()
	if rowsAffected == 0 {
		return Response{
			Success: false,
			Message: "Pengeluaran tidak ditemukan",
		}
	}

	return Response{
		Success: true,
		Message: "Pengeluaran berhasil dihapus",
	}
}

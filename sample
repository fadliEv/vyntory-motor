// GetMotorStats mengambil statistik motor
func (a *App) GetMotorStats() Response {
	// Total motor dan total harga
	var totalMotor int
	var totalHarga float64

	err := a.db.QueryRow("SELECT COUNT(*), COALESCE(SUM(harga), 0) FROM motors").Scan(&totalMotor, &totalHarga)
	if err != nil {
		return Response{
			Success: false,
			Message: "Gagal mengambil statistik: " + err.Error(),
		}
	}

	// Motor per status
	statusCounts := make(map[string]int)
	statuses := []string{"tersedia", "terjual", "dalam_perbaikan"}

	for _, status := range statuses {
		var count int
		a.db.QueryRow("SELECT COUNT(*) FROM motors WHERE status = ?", status).Scan(&count)
		statusCounts[status] = count
	}

	// Rata-rata harga
	averageHarga := 0.0
	if totalMotor > 0 {
		averageHarga = totalHarga / float64(totalMotor)
	}

	stats := map[string]interface{}{
		"total_motor":     totalMotor,
		"total_harga":     totalHarga,
		"rata_rata_harga": averageHarga,
		"motor_tersedia":  statusCounts["tersedia"],
		"motor_terjual":   statusCounts["terjual"],
		"motor_perbaikan": statusCounts["dalam_perbaikan"],
	}

	return Response{
		Success: true,
		Data:    stats,
	}
}

// GetFinancialStats mengambil statistik keuangan
func (a *App) GetFinancialStats(bulan int, tahun int) Response {
	// Filter untuk bulan dan tahun
	var filterQuery string
	var filterArgs []interface{}

	if bulan > 0 && tahun > 0 {
		filterQuery = " AND strftime('%Y-%m', tanggal_masuk) = ?"
		filterArgs = append(filterArgs, fmt.Sprintf("%d-%02d", tahun, bulan))
	}

	// Total pendapatan (motor terjual)
	var totalPendapatan float64
	queryPendapatan := "SELECT COALESCE(SUM(harga), 0) FROM motors WHERE status = 'terjual'" + filterQuery
	var err error
	if len(filterArgs) > 0 {
		err = a.db.QueryRow(queryPendapatan, filterArgs...).Scan(&totalPendapatan)
	} else {
		err = a.db.QueryRow(queryPendapatan).Scan(&totalPendapatan)
	}
	if err != nil {
		return Response{
			Success: false,
			Message: "Gagal mengambil total pendapatan: " + err.Error(),
		}
	}

	// Total modal (semua motor yang tersedia dan dalam perbaikan)
	var totalModal float64
	queryModal := "SELECT COALESCE(SUM(harga), 0) FROM motors WHERE status IN ('tersedia', 'dalam_perbaikan')" + filterQuery
	if len(filterArgs) > 0 {
		err = a.db.QueryRow(queryModal, filterArgs...).Scan(&totalModal)
	} else {
		err = a.db.QueryRow(queryModal).Scan(&totalModal)
	}
	if err != nil {
		return Response{
			Success: false,
			Message: "Gagal mengambil total modal: " + err.Error(),
		}
	}

	// Keuntungan bersih (pendapatan - modal terjual, asumsi modal 70% dari harga jual)
	var modalTerjual float64
	queryModalTerjual := "SELECT COALESCE(SUM(harga * 0.7), 0) FROM motors WHERE status = 'terjual'" + filterQuery
	if len(filterArgs) > 0 {
		err = a.db.QueryRow(queryModalTerjual, filterArgs...).Scan(&modalTerjual)
	} else {
		err = a.db.QueryRow(queryModalTerjual).Scan(&modalTerjual)
	}
	if err != nil {
		return Response{
			Success: false,
			Message: "Gagal mengambil modal terjual: " + err.Error(),
		}
	}
	keuntunganBersih := totalPendapatan - modalTerjual

	stats := map[string]interface{}{
		"total_pendapatan":  totalPendapatan,
		"total_modal":       totalModal,
		"modal_terjual":     modalTerjual,
		"keuntungan_bersih": keuntunganBersih,
		"persentase_untung": (keuntunganBersih / totalPendapatan) * 100,
	}

	return Response{
		Success: true,
		Data:    stats,
	}
}

// Expense model
type Expense struct {
	ID         string    `json:"id"`
	Keterangan string    `json:"keterangan"`
	Jumlah     float64   `json:"jumlah"`
	Tanggal    string    `json:"tanggal"`
	Kategori   string    `json:"kategori"`
	CreatedAt  time.Time `json:"created_at"`
}

// AddExpense menambahkan pengeluaran harian
func (a *App) AddExpense(keterangan string, jumlah float64, tanggal string, kategori string) Response {
	// Validasi input
	if keterangan == "" {
		return Response{
			Success: false,
			Message: "Keterangan pengeluaran harus diisi",
		}
	}

	if jumlah <= 0 {
		return Response{
			Success: false,
			Message: "Jumlah pengeluaran harus lebih dari 0",
		}
	}

	// Validasi format tanggal
	if tanggal != "" {
		_, err := time.Parse("2006-01-02", tanggal)
		if err != nil {
			return Response{
				Success: false,
				Message: "Format tanggal tidak valid. Gunakan YYYY-MM-DD",
			}
		}
	} else {
		tanggal = time.Now().Format("2006-01-02")
	}

	// Generate ID
	id := fmt.Sprintf("EXP-%d", time.Now().UnixNano())

	// Insert ke database
	query := `INSERT INTO expenses (id, keterangan, jumlah, tanggal, kategori) 
              VALUES (?, ?, ?, ?, ?)`

	_, err := a.db.Exec(query, id, keterangan, jumlah, tanggal, kategori)
	if err != nil {
		return Response{
			Success: false,
			Message: "Gagal menambahkan pengeluaran: " + err.Error(),
		}
	}

	return Response{
		Success: true,
		Message: "Pengeluaran berhasil ditambahkan",
		Data:    id,
	}
}

